{
  "manifest_version": 3,
  "name": "Jira Exporter",
  "version": "0.1.0",
  "description": "Export Jira issues into a single ZIP report package with attachments saved locally.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jira Exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
